#!/bin/sh
# Ставится после распаковки файлов пакета.

set -e

# Первая установка или обновление. Отличаем по файлу ссылок: при
# обновлении он уже есть, потому что создаётся здесь же и только при
# отсутствии. Нужно, чтобы подсказку «куда идти дальше» показывать один
# раз, а не при каждом обновлении.
first_install=no
[ -f /opt/etc/shadowfox/nodes.txt ] || first_install=yes

chmod 0755 /opt/bin/shadowfoxd            2>/dev/null || true
chmod 0755 /opt/etc/init.d/S99shadowfox   2>/dev/null || true
chmod 0755 /opt/etc/ndm/netfilter.d/015-shadowfox.sh      2>/dev/null || true
chmod 0755 /opt/etc/ndm/ifstatechanged.d/015-shadowfox.sh 2>/dev/null || true

# Короткая команда управления: `shadowfox status`, `shadowfox restart` и т.д.
ln -sf /opt/etc/init.d/S99shadowfox /opt/bin/shadowfox

# Политика ShadowFox — сразу при установке, как у HydraRoute: на странице
# остаётся только создать подключение, и оно само войдёт в политику.
# Команда идемпотентна, при обновлении ничего не меняет.
ndmc=""
for c in /opt/bin/ndmc /opt/sbin/ndmc /usr/bin/ndmc /usr/sbin/ndmc /bin/ndmc /sbin/ndmc; do
    [ -x "$c" ] && { ndmc="$c"; break; }
done
if [ -n "$ndmc" ] && ! "$ndmc" -c "show running-config" 2>/dev/null | grep -q "^ip policy ShadowFox"; then
    "$ndmc" -c "ip policy ShadowFox" >/dev/null 2>&1 && \
    "$ndmc" -c "system configuration save" >/dev/null 2>&1 && \
    echo "[ИНФО] политика ShadowFox создана в роутере"
fi

mkdir -p /opt/etc/shadowfox
chmod 0700 /opt/etc/shadowfox 2>/dev/null || true

# Файл настроек не лежит в пакете, а пишется демоном при первой
# установке — из тех же значений по умолчанию, что вшиты в него. Иначе
# было бы два источника правды, и они уже расходились: в образце
# из пакета не хватало ключей. И opkg при каждом обновлении ругался
# на изменённый conffile и складывал рядом shadowfox.conf-opkg.
keep=/opt/etc/shadowfox/.shadowfox.conf.keep
if [ ! -f /opt/etc/shadowfox/shadowfox.conf ]; then
    if [ -f "$keep" ]; then
        # opkg удалил конфиг как устаревший файл старого пакета, см. preinst.
        mv "$keep" /opt/etc/shadowfox/shadowfox.conf
        echo "[ИНФО] настройки возвращены из копии, сделанной перед обновлением"
    else
        /opt/bin/shadowfoxd --genconfig /opt/etc/shadowfox >/dev/null 2>&1 || \
            echo "[WARN] не удалось записать /opt/etc/shadowfox/shadowfox.conf"
    fi
fi
rm -f "$keep"
# Остаток от прежней схемы, когда образец ехал в пакете.
rm -f /opt/etc/shadowfox/shadowfox.conf-opkg

# Списки создаём только при отсутствии. Файлами пакета их держать нельзя:
# это пользовательские данные, и при каждой правке шаблона opkg оставлял
# бы рядом domain.conf-opkg.
# Списки создаём только при отсутствии из готовых образцов: YouTube,
# TikTok, Discord, Telegram — как у HydraRoute, чтобы после установки
# было что включить, а не пустой файл. Файлами пакета их держать нельзя:
# это пользовательские данные, и при каждой правке образца opkg
# оставлял бы рядом domain.conf-opkg. Образцы лежат в presets/ и всегда
# доступны: cp /opt/etc/shadowfox/presets/* /opt/etc/shadowfox/
[ -f /opt/etc/shadowfox/domain.conf ] || cp /opt/etc/shadowfox/presets/domain.conf /opt/etc/shadowfox/domain.conf
[ -f /opt/etc/shadowfox/ip.list ]     || cp /opt/etc/shadowfox/presets/ip.list     /opt/etc/shadowfox/ip.list

# Намеренно НЕ правим /opt/etc/init.d/rc.unslung.
# neofit и hrneo вставляют туда `sleep 10`, чтобы дождаться сети роутера.
# Это правка чужого общего файла ради задержки на старте. Вместо этого
# демон переживает неготовую сеть и поднимает правила по SIGUSR1,
# который ему шлют ndm-хуки при первом же событии интерфейса.

# Предупреждение о соседстве, а не запрет: по файлам мы с HydraRoute не
# пересекаемся и спокойно стоим рядом. Конфликт начнётся, когда Shadow Fox
# начнёт править netfilter и управлять xray — тем же, чем владеет он.
if [ -x /opt/bin/hrneo ] || [ -d /opt/etc/HydraRoute ]; then
    echo "[ИНФО] обнаружен HydraRoute."
    echo "       Общих файлов у них нет, службы уживаются."
    echo "       Но маршрутизацию теперь умеют оба. Свои списки Shadow Fox"
    echo "       берёт из /opt/etc/shadowfox/domain.conf; готовые группы там"
    echo "       есть с установки, но правила ставятся только после того,"
    echo "       как политика ShadowFox будет настроена на странице."
    echo "       Посмотреть, что будет сделано: shadowfoxd --dry-run"
fi

/opt/etc/init.d/S99shadowfox stop  >/dev/null 2>&1 || true
/opt/etc/init.d/S99shadowfox start >/dev/null 2>&1 || \
    echo "[WARN] не удалось запустить shaper, см. /opt/var/log/shadowfoxd.log"

# Куда идти дальше. Без этого после установки терминал молчит, и человек
# не знает ни что есть веб-интерфейс, ни его адреса. Показываем только
# при первой установке: при обновлении настройки уже сделаны.
if [ "$first_install" = yes ]; then
    LAN=$(ip -4 addr show br0 2>/dev/null | sed -n 's/.*inet \([0-9.]*\).*/\1/p' | head -1)
    [ -n "$LAN" ] || LAN=192.168.1.1

    echo ""
    echo "  Shadow Fox установлен."
    echo ""
    echo "  Интерфейс:  http://$LAN:8090"
    echo "  Вход:       логин и пароль администратора роутера"
    echo ""
    echo "  Дальше в разделе «Подключения»: поставить ядро Xray кнопкой,"
    echo "  вставить ссылку vless://, создать подключение в роутере и"
    echo "  настроить политику доступа. Каждый шаг там расписан."
    echo ""
    echo "  Состояние в любой момент:  shadowfoxd --status"
    echo ""
fi

exit 0
