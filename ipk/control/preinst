#!/bin/sh
# Выполняется до распаковки нового пакета.
#
# До 0.1.0-124 файл настроек ехал в пакете как conffile. Когда он оттуда
# исчез, opkg при обновлении сначала удаляет его как «устаревший файл»
# старого пакета и лишь потом проверяет, не изменён ли он, — файла к тому
# моменту уже нет. Так один раз пропали настройки. Откладываем копию
# заранее; postinst вернёт её, если оригинала не окажется.
if [ -f /opt/etc/shadowfox/shadowfox.conf ]; then
    cp -p /opt/etc/shadowfox/shadowfox.conf /opt/etc/shadowfox/.shadowfox.conf.keep
fi
exit 0
