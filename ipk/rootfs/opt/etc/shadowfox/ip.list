# Статические подсети, которые нужно заворачивать в туннель.
#
# Формат:
#
#   [имя-группы]
#   interface = Proxy0
#   192.0.2.0/24
#   2001:db8::/32
#
# Нужен для сервисов с хардкодом IP, которые не спрашивают DNS,
# — там перехват DNS-ответов бессилен.

# [example]
# interface = Proxy0
# 192.0.2.0/24
