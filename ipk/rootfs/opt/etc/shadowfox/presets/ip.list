# Статические подсети, которые нужно заворачивать в туннель.
#
#   [имя-группы]
#   interface = ShadowFox
#   192.0.2.0/24
#   2001:db8::/32
#
# Нужны для сервисов с зашитыми адресами, которые не спрашивают DNS, —
# там перехват ответов бессилен. Telegram — как раз такой: приложения
# ходят по адресам своих дата-центров напрямую.

[Telegram]
interface = ShadowFox
91.108.4.0/22
91.108.8.0/22
91.108.12.0/22
91.108.16.0/22
91.108.20.0/22
91.108.56.0/22
91.105.192.0/23
149.154.160.0/20
185.76.151.0/24
2001:b28:f23c::/48
2001:b28:f23d::/48
2001:b28:f23f::/48
2001:67c:4e8::/48
